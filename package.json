{
  "name": "roomora",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start --lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:build": "expo export --platform web",
    "doctor": "expo-doctor",
    "test": "node scripts/test-domain.mjs",
    "test:e2e:web": "playwright test tests/web-smoke.spec.js",
    "release:check": "npm run test && npm run doctor && npm run export:android && npm run export:ios",
    "version:set": "node scripts/set-app-version.mjs",
    "build:development": "eas build --profile development --platform all",
    "build:preview": "eas build --profile preview --platform all",
    "build:store": "eas build --profile production --platform all",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo/metro-runtime": "~57.0.7",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.25",
    "@tanstack/react-query": "^5.87.1",
    "@tanstack/react-query-devtools": "^5.87.1",
    "@types/react": "~19.2.10",
    "axios": "^1.6.8",
    "expo": "~57.0.8",
    "expo-apple-authentication": "~57.0.1",
    "expo-auth-session": "~57.0.5",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.9",
    "expo-font": "~57.0.0",
    "expo-image-manipulator": "~57.0.6",
    "expo-image-picker": "~57.0.6",
    "expo-linear-gradient": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.10",
    "expo-web-browser": "~57.0.2",
    "prop-types": "^15.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-picker-select": "^9.3.1",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.0",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@playwright/test": "^1.61.1",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~57.0.0",
    "expo-doctor": "^1.20.0"
  }
}
